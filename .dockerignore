# Dependency, dibangun ulang di dalam image
**/node_modules
**/vendor

# Rahasia: tidak boleh masuk image, dikirim lewat env_file saat container jalan
.env
.env.*
pos-restapi/.env
pos-restapi/.env.*
pos-web/.env.local
pos-web/.env.*.local

# Data runtime Laravel dari development
pos-restapi/storage
# Symlink buatan `php artisan storage:link` saat dev (menunjuk ke path di dalam container), dibuat ulang di entrypoint
pos-restapi/public/storage
# Cache bootstrap dari dev bisa mereferensikan paket dev yang tidak terpasang di produksi
pos-restapi/bootstrap/cache/*.php

# Hasil build FE
pos-web/dist

# File yang tidak dibutuhkan image
**/.git
**/.vscode
**/.idea
**/*.log
docs
CLAUDE.md