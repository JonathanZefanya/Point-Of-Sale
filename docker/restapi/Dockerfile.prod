FROM composer:2 AS vendor
WORKDIR /app
COPY pos-restapi/composer.json pos-restapi/composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --no-autoloader \
    --prefer-dist --ignore-platform-reqs
COPY pos-restapi/ .
RUN composer dump-autoload --optimize --no-dev

FROM php:8.3-fpm
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nginx supervisor libzip-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev libicu-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql gd zip bcmath intl opcache \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html
COPY --from=vendor /app /var/www/html
COPY docker/restapi/nginx.conf /etc/nginx/sites-available/default
COPY docker/restapi/supervisord.conf /etc/supervisor/conf.d/app.conf
COPY docker/restapi/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh
# storage/ tidak ikut di-copy (.dockerignore) → buat struktur foldernya di sini
RUN chmod +x /usr/local/bin/entrypoint.prod.sh \
    && mkdir -p storage/app/public storage/framework/cache/data storage/framework/sessions \
        storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

EXPOSE 80
ENTRYPOINT ["entrypoint.prod.sh"]
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]